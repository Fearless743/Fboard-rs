# Fboard Rust core (MySQL/MariaDB)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fboard
DB_USERNAME=fboard
DB_PASSWORD=change-me

# Public site URL used by subscriptions, payments and mail links.
APP_URL=http://127.0.0.1:7001
# Must match the existing panel APP_KEY (used to derive the default secure path).
APP_KEY=

FBOARD_LISTEN=0.0.0.0:7001
FBOARD_LOG=info

# Lua plugins: plugins/<code>/plugin.json + init.lua
FBOARD_PLUGIN_DIRS=plugins

# Optional Redis pub/sub for multi-instance WebSocket fan-out
# REDIS_URL=redis://127.0.0.1:6379/0
# or REDIS_HOST=127.0.0.1 / REDIS_PORT=6379 / REDIS_PASSWORD= / REDIS_DB=0

# Built admin SPA output
FBOARD_ADMIN_DIST=public/assets/admin
FBOARD_UPLOAD_DIR=storage/app
